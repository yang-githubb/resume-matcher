# Ollama (uses GPU on 9070 XT when Ollama is configured for it)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Embeddings — CPU is fine for 1–2 resumes; set cuda if you have NVIDIA
EMBEDDING_DEVICE=cpu
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Hybrid score weights (must sum to 1.0)
SEMANTIC_WEIGHT=0.6
KEYWORD_WEIGHT=0.4

# Paths
DATABASE_PATH=./data/resume_matcher.db
UPLOAD_DIR=./data/uploads
