# Ollama (uses GPU on 9070 XT when Ollama is configured for it)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Embeddings — CPU is fine for 1–2 resumes; set cuda if you have NVIDIA
EMBEDDING_DEVICE=cpu
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Hybrid score weights (must sum to 1.0)
SEMANTIC_WEIGHT=0.6
KEYWORD_WEIGHT=0.4

# Paths
DATABASE_PATH=./data/resume_matcher.db
UPLOAD_DIR=./data/uploads

# Optional — online job search.
# Remotive, RemoteOK, Arbeitnow and Jobicy need no key and work out of the box.

# JSearch pulls Google for Jobs results (LinkedIn, Indeed and the rest)
# worldwide. Free tier: rapidapi.com -> JSearch.
JSEARCH_API_KEY=

# Adzuna adds onsite listings across 18 countries, US and Europe among them.
# Free key from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
